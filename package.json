{
  "name": "still",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "shared",
    "institutions"
  ],
  "scripts": {
    "web:export": "npm run export:web -w @still/client",
    "institutions:dev": "npm run dev -w @still/institutions",
    "institutions:build": "npm run build -w @still/institutions",
    "dev": "npm run web:export && npm run institutions:build && next dev",
    "dev:hot": "rm -rf public && (npm run web -w @still/client & EXPO_WEB_DEV_URL=http://localhost:8081 next dev)",
    "build": "npm run web:export && npm run institutions:build && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate --config src/server/db/drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate --config src/server/db/drizzle.config.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/server/db/reset.ts && npm run db:migrate && npm run db:seed",
    "db:seed": "tsx --env-file-if-exists=.env src/server/db/seed.ts",
    "media:reconcile": "tsx --env-file-if-exists=.env src/server/media/reconcile.ts",
    "client": "npm run start -w @still/client",
    "client:ios": "npm run ios -w @still/client",
    "client:android": "npm run android -w @still/client",
    "client:typecheck": "npm run typecheck -w @still/client",
    "e2e": "playwright test --project=chromium",
    "e2e:server": "tsx --env-file-if-exists=.env src/server/db/reset.ts && npm run db:migrate && npm run db:seed && npm run db:seed && npm run db:seed e2e/fixtures && npm run build && next start -p $E2E_PORT -H localhost"
  },
  "dependencies": {
    "@trpc/server": "^11.22.1",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
