{
  "name": "still",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "client": "npm run start -w @still/client",
    "client:ios": "npm run ios -w @still/client",
    "client:android": "npm run android -w @still/client",
    "client:typecheck": "npm run typecheck -w @still/client",
    "e2e": "playwright test --project=chromium",
    "e2e:server": "next build && next start -p $E2E_PORT -H localhost"
  },
  "dependencies": {
    "@trpc/server": "^11.22.1",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
