{
  "expo": {
    "name": "Still",
    "slug": "still",
    "version": "1.0.0",
    "scheme": "still",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.still.placeholder"
    },
    "android": {
      "package": "app.still.placeholder",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-camera", { "cameraPermission": "Allow STILL to scan exhibition QR codes.", "recordAudioAndroid": false }],
      "expo-audio",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ]
  }
}
