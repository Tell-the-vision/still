# ---------------------------------------------------------------------------
# STILL — environment variables
# Copy this file to `.env` and fill in what you need.
# Everything is optional for local development: with an empty .env the app
# runs on an embedded Postgres (PGlite) and offers a "Dev Login" instead of Google.
# ---------------------------------------------------------------------------

# Public URL of the app. Used to build the exhibition URLs encoded in QR codes.
# Leave empty to use the current request origin (fine for local dev).
NEXT_PUBLIC_APP_URL=

# --- Database (PostgreSQL) ----------------------------------------------------
# Local default: PGlite, an embedded Postgres stored under ./data/pg.
# Nothing to install; the folder is created and seeded on first `npm run dev`.
DATABASE_URL=file:./data/pg
# Shared / production: any Postgres connection string (Neon, Supabase,
# Railway, Docker …). Hosted providers need TLS, which is on by default for
# non-localhost hosts; override with DATABASE_SSL=false / require if needed.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# DATABASE_SSL=
# DATABASE_POOL_MAX=5

# --- Media storage (Cloudflare R2, optional) ----------------------------------
# When all four R2_* values are set, uploaded cover images go to the bucket and
# are served from MEDIA_BASE_URL (the bucket's public custom domain). Leave
# empty to keep images in the database (fine for local dev).
# The bucket (or its domain) needs a CORS rule allowing GET from the app's
# origin — the keepsake PNG export draws the cover image onto a canvas.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MEDIA_BASE_URL=

# --- Auth.js ----------------------------------------------------------------
# Any long random string. Generate with:  openssl rand -base64 32
# (In development a built-in fallback is used when this is empty.)
AUTH_SECRET=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application).
# Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
# When these are empty the Google button is hidden and Dev Login is shown.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Force the Dev Login (email-only, no password) even when Google is configured.
# Never enable in production.
ENABLE_DEV_LOGIN=

# --- Roles --------------------------------------------------------------------
# Comma-separated emails that become ADMIN automatically on sign-in.
# With Dev Login you can simply log in as this address to reach /admin.
ADMIN_EMAILS=admin@still.local
