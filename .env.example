# STILL environment variables. Copy to `.env` and fill in. Never commit values.
# Local dev DB. Production sets DATABASE_URL in the Dokploy app env (internal service host); never point local .env at production.
DATABASE_URL=postgres://localhost:5432/still
# Public origin; must match the browser address bar exactly (cookies)
STILL_ORIGIN=
# Google OAuth (web and native clients)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_NATIVE_REDIRECT_URIS=
ACCESS_TOKEN_SECRET=
TOKEN_ENC_KEYS=
KEEPSAKE_TICKET_SECRET=
SESSION_REFRESH_GRACE_SECONDS=
# Policy versions, public URLs and client gate
TERMS_VERSION=
TERMS_URL=
PRIVACY_VERSION=
PRIVACY_URL=
MIN_CLIENT_VERSION=
RATE_LIMIT_IP_PER_MIN=
RATE_LIMIT_USER_PER_MIN=
# Cloudflare R2 media storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Private bucket for institutions' uploaded originals (SPEC §9.4); never served publicly. Needs a CORS rule
# allowing PUT from the console origin.
R2_PRIVATE_BUCKET=
# Temporary bucket for the copies shown to the model (SPEC §9.4), written by the browser, same CORS rule.
R2_MODEL_INPUTS_BUCKET=
R2_DRY_RUN=
# With R2_DRY_RUN=1 objects are kept on local disk here (default: the OS temp dir) and served by /api/r2-dry-run.
R2_DRY_RUN_DIR=
MEDIA_BASE_URL=
APPLE_TEAM_ID=
IOS_BUNDLE_ID=gdg.still.app
ANDROID_PACKAGE=gdg.still.app
ANDROID_SHA256_FINGERPRINTS=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_STILL_ORIGIN=
EXPO_WEB_DEV_URL=
